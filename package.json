{
  "name": "citeflow-word-addin",
  "version": "1.0.0",
  "description": "CiteFlow - A vibrant citation search and bibliography add-in for Microsoft Word",
  "main": "src/taskpane.js",
  "scripts": {
    "build": "webpack --mode production",
    "dev": "webpack --mode development --watch",
    "start": "office-addin-debugging start manifest.xml",
    "stop": "office-addin-debugging stop manifest.xml",
    "validate": "office-addin-manifest validate manifest.xml"
  },
  "keywords": ["office-addin", "word", "citation", "bibliography", "reference"],
  "author": "CiteFlow",
  "license": "MIT",
  "devDependencies": {
    "@types/office-js": "^1.0.377",
    "@types/office-runtime": "^1.0.35",
    "office-addin-debugging": "^5.1.1",
    "office-addin-dev-certs": "^2.3.1",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.4",
    "copy-webpack-plugin": "^12.0.2",
    "html-webpack-plugin": "^5.6.0",
    "css-loader": "^6.10.0",
    "style-loader": "^3.3.4"
  }
}